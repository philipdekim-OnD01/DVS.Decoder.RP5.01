[Unit]
Description=S5KRC1S RAW2 production web and HDMI pipeline
After=network-online.target display-manager.service
Wants=network-online.target display-manager.service
ConditionPathExists=/home/philip/dvs_raw2_production/raw2_producer

[Service]
Type=simple
User=root
Group=root
ExecStart=/home/philip/dvs_raw2_production/raw2_production_start.sh
TimeoutStartSec=0
TimeoutStopSec=45
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
